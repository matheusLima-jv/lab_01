# EditorConfig: padroniza indentação, encoding e quebra de linha em qualquer
# IDE/editor, evitando diffs gigantes causados só por formatação.
# Referência: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,md,xml,http}]
indent_size = 2

[*.md]
# Em Markdown, dois espaços no fim da linha significam quebra de linha.
trim_trailing_whitespace = false

[{mvnw,*.sh}]
end_of_line = lf

[*.cmd]
end_of_line = crlf
