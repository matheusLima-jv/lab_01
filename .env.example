# Copie para ".env" (que está no .gitignore) e ajuste os valores.
# O docker compose lê o ".env" automaticamente.

# Segredo HMAC do JWT, em Base64, com pelo menos 32 bytes.
# Gere com: openssl rand -base64 32
JWT_SECRET=

# Conta de operador criada na subida
OPERATOR_EMAIL=operador@logistics.local
OPERATOR_PASSWORD=troque-esta-senha

# Front-ends autorizados a chamar a API pelo navegador (separados por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:5173
